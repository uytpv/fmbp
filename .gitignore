# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
functions/lib/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.node_repl_history
dist/
out/
functions/.runtimeconfig.json

